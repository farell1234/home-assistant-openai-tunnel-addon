daemon off;
error_log stderr warn;
pid /tmp/nginx.pid;

events {
  worker_connections 64;
}

http {
  access_log off;
  client_body_temp_path /tmp/nginx-client-body;
  proxy_temp_path /tmp/nginx-proxy;

  server {
    listen 127.0.0.1:18081;
    server_name localhost;

    location = /healthz-local {
      return 204;
    }

    location = /api/mcp/assist {
      limit_except GET POST DELETE OPTIONS {
        deny all;
      }

      proxy_pass http://homeassistant/api/mcp/assist;
      proxy_http_version 1.1;
      proxy_set_header Host homeassistant;
      proxy_set_header Authorization "Bearer __HOME_ASSISTANT_ACCESS_TOKEN__";
      proxy_set_header Connection "";
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    location / {
      return 404;
    }
  }
}
